# Copy to .env and adjust for your environment.

# Local development (no server required)
DATABASE_URL=sqlite:///./weathergpt.db

# Shared PostgreSQL (docker-compose / team database server)
# DATABASE_URL=postgresql+psycopg://weathergpt:weathergpt@localhost:5432/weathergpt

ENVIRONMENT=development

# --- Agent layer (src/agents/weathergpt_agent) ------------------------------
# Models in preference order, as "provider:model" specs.
# Groq is the default provider. Set your GROQ_API_KEY below.
LLM_MODELS=groq:openai/gpt-oss-120b
GROQ_API_KEY=
# GOOGLE_API_KEY=

# The agent talks to weather_backend over HTTP. In the integrated gateway
# (src/gateway/main.py), weather_backend is mounted on the same process at
# /backend, so this should stay pointed there unless you run weather_backend
# as its own separate service.
WEATHER_BACKEND_URL=http://127.0.0.1:8000/backend
# WEATHER_BACKEND_API_KEY=

# --- weather_backend (src/agents/weather_backend) ---------------------------
# Optional: enables the IMD tier. Without it, every response still returns real
# live data from Open-Meteo, just labelled official=false for hazard/advisory.
# IMD_API_KEY=
# IMD_BASE_URL=https://api.imd.gov.in/api/v1
